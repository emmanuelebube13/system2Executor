# =============================================================================
# System 2 — config template (NAMES ONLY, NO VALUES).
# Copy to config/.env.system2 (git-ignored) on the new computer and fill in.
# Startup FAILS CLOSED if a required secret is missing (exit code 2, message names the key).
# Never commit real values. (Heed scalable-brain FIX-XC-003: a committed DB password happened once.)
# Keys below are the exact names the code reads (secrets.require/get). [REQUIRED]=must be set.
# =============================================================================

# --- Broker: OANDA (practice is the default and only mode reachable without BOTH
#     a live key AND the explicit toggle) ---
OANDA_ENV=practice                       # practice | live  (live requires live creds + toggle)
OANDA_PRACTICE_API_KEY=                  # [REQUIRED in practice]
OANDA_PRACTICE_ACCOUNT_ID=               # [REQUIRED in practice] e.g. 101-002-38449021-001
OANDA_PRACTICE_URL=https://api-fxpractice.oanda.com
# Live — stored separately, toggle-gated; leave blank unless going live (logged decision D-004):
OANDA_LIVE_API_KEY=                      # [REQUIRED only if OANDA_ENV=live]
OANDA_LIVE_ACCOUNT_ID=                   # [REQUIRED only if OANDA_ENV=live]
OANDA_LIVE_URL=https://api-fxtrade.oanda.com
SLIPPAGE_TOLERANCE_PIPS=2
BROKER_RETRY_MAX=3
BROKER_RETRY_BACKOFF_SEC=2

# --- Object storage (model artifacts in, System 1 -> System 2) ---
STORAGE_PROVIDER=gcs                     # gcs | localfs
GCS_BUCKET=                              # [REQUIRED if STORAGE_PROVIDER=gcs]
STORAGE_LOCAL_ROOT=                      # [REQUIRED if STORAGE_PROVIDER=localfs] source dir (dev)
GOOGLE_APPLICATION_CREDENTIALS=          # path to read-only service-account JSON (never commit the JSON)
ARTIFACT_ROOT=state/model-cache         # [REQUIRED] local dir the downloader promotes sets into
MODEL_POLL_INTERVAL_SEC=300
MODEL_VERIFY_STRICT=true

# --- Message queue (orders/fills/control) — decision D-002: Google Cloud Pub/Sub ---
QUEUE_PROVIDER=pubsub                    # pubsub | local (local durable, dev/test)
PUBSUB_PROJECT_ID=                       # [REQUIRED if QUEUE_PROVIDER=pubsub]
OUTBOUND_QUEUE_NAME=                     # [REQUIRED] subscription this consumer PULLS (orders in)
INBOUND_QUEUE_NAME=                      # [REQUIRED] topic this PUBLISHES to (fills + control out)
QUEUE_DLQ_TOPIC=                         # dead-letter topic
QUEUE_MAX_DELIVERY_ATTEMPTS=5
QUEUE_LOCAL_PATH=state/queue/queue.db    # used only when QUEUE_PROVIDER=local
FILL_OUTBOX_PATH=state/queue/fill_outbox.db
FILL_PUBLISH_RETRY_MAX=5
ORDER_MAX_AGE_SEC=300

# --- Local datastore on the new computer (decision D-001) ---
DB_PROVIDER=sqlite                       # sqlite (dev) | postgres (prod)
DB_PATH=state/db/system2.db              # used when DB_PROVIDER=sqlite
DB_DSN=                                  # [REQUIRED if DB_PROVIDER=postgres] e.g. postgresql://user:pass@localhost/system2
DB_RECORD_ENABLED=true                   # write Fact_Live_Trades (persist-then-publish)
PROCESSED_STORE_PATH=state/offsets/processed.db

# --- Execution mode / safety hold ---
EXEC_MODE=execution_only                 # execution_only | legacy
EXEC_SHADOW=true                         # true = construct+validate but SUBMIT NOTHING (flip only after D-004)
MAX_OPEN_POSITIONS=8                     # backup correlation guard (backstop, not sizing)

# --- Last-line-of-defense sanity bounds (fat-finger guard, NOT sizing — §7.2) ---
REQUIRE_STOP_LOSS=true
MAX_UNITS_PER_PAIR=                      # e.g. 1000000
MAX_TOTAL_NOTIONAL=                      # e.g. 5000000
MAX_LEVERAGE=                            # e.g. 30
TRADEABLE_INSTRUMENTS=                   # optional CSV allowlist, e.g. EUR_USD,GBP_USD (blank = allow all)

# --- Safety / staleness (EXEC-008) ---
STALENESS_LIMIT_SEC=300                  # > 5 min stale ⇒ PAUSE
STALENESS_HYSTERESIS_SEC=30              # anti-flap margin to auto-resume
EXEC_BYPASS_ENABLE=false                 # opt-in, audited, conservative sizing only
BYPASS_CONFIRM_TOKEN=                    # required to activate BYPASS
BYPASS_RISK_PCT=0.25
BYPASS_MAX_POSITIONS=3
BYPASS_MAX_DURATION_SEC=3600

# --- Trade-close tracking (EXEC-012) ---
CLOSE_SWEEP_INTERVAL_SEC=30              # broker-close sweep cadence (one OpenTrades call/sweep)
S3_CLOSE_TOPIC=ams-inbound.ams           # S3-side topic for flat close FillEvents (bridge can't translate closes)
CLOSE_LEDGER_PATH=state/offsets/close_sweep.db  # sweep ledger: one broker close -> one close event

# --- Lifecycle / emergency STOP (EXEC-010) ---
STOP_SENTINEL_PATH=state/control/STOP    # `touch` this file to trigger emergency STOP
EXEC_STOP_FLATTEN=false                  # false = leave positions (broker stop protects them); true = flatten on stop

# --- Health / telemetry (EXEC-009) — private network only ---
HEALTH_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8002
